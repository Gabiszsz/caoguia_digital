                <div id="toastNotification" role="status" aria-live="assertive"
                    class="fixed top-24 right-5 z-[70] max-w-sm bg-gray-900 text-white px-5 py-4 rounded-2xl shadow-2xl border-2 border-brand-500 flex items-center gap-3 transform translate-x-[130%] transition-transform duration-300">
