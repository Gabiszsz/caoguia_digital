<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cão Guia Digital - IF Goiano | Acessibilidade Inclusiva</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts (Poppins & Lexend para alta legibilidade) -->
    <link
        href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;600;700&family=Poppins:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f4f7f2',
                            100: '#e3ebd9',
                            200: '#c7d9b5',
                            500: '#5e8940',
                            600: '#4c6c32',
                            700: '#3a5327',
                            800: '#2c3e1e',
                            900: '#1e2b15',
                        },
                        earth: {
                            100: '#f9f6f0',
                            200: '#eddccb',
                            500: '#be926e',
                            600: '#a37553',
                        }
                    },
                    fontFamily: {
                        sans: ['Poppins', 'sans-serif'],
                        readable: ['Lexend', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        /* =========================================================
           1. ANÉIS DE FOCO DE ALTA VISIBILIDADE (WCAG AAA)
           ========================================================= */
        *:focus-visible {
            outline: 3px solid #d97706 !important;
            outline-offset: 3px !important;
            box-shadow: 0 0 0 6px rgba(217, 119, 6, 0.25) !important;
        }

        /* Destaque visual durante leitura por voz */
        .reader-highlight {
            outline: 3px solid #2563eb !important;
            outline-offset: 4px;
            background-color: rgba(37, 99, 235, 0.12) !important;
            border-radius: 0.75rem;
            transition: all 0.2s ease-in-out;
        }

        /* =========================================================
           2. FILTROS DE DALTONISMO (APLICAÇÃO NO CONTAINER PRINCIPAL)
           Nota: Aplicado ao wrapper principal para não quebrar elementos fixed
           ========================================================= */
        body.cb-protanopia #app-wrapper {
            filter: url('#protanopia-filter');
        }

        body.cb-deuteranopia #app-wrapper {
            filter: url('#deuteranopia-filter');
        }

        body.cb-tritanopia #app-wrapper {
            filter: url('#tritanopia-filter');
        }

        body.cb-achromatopsia #app-wrapper {
            filter: url('#achromatopsia-filter');
        }

        /* Reforço visual não-dependente de cor quando modo daltonismo está ativo */
        body[class*="cb-"] a:not(.no-underline-cb),
        body[class*="cb-"] button {
            text-decoration: underline;
            text-underline-offset: 3px;
        }

        body[class*="cb-"] .status-badge {
            border: 2px dashed currentColor !important;
            font-weight: 800 !important;
        }

        /* =========================================================
           3. MODOS DE CONTRASTE E LEGIBILIDADE
           ========================================================= */
        /* Alto Contraste (Preto + Amarelo) */
        body.high-contrast {
            background-color: #000000 !important;
            color: #ffffff !important;
        }

        body.high-contrast .glass-card,
        body.high-contrast header,
        body.high-contrast aside,
        body.high-contrast footer,
        body.high-contrast input,
        body.high-contrast select,
        body.high-contrast textarea,
        body.high-contrast details {
            background: #0a0a0a !important;
            background-color: #0a0a0a !important;
            color: #ffffff !important;
            border: 2px solid #ffff00 !important;
        }

        body.high-contrast h1,
        body.high-contrast h2,
        body.high-contrast h3,
        body.high-contrast h4,
        body.high-contrast button,
        body.high-contrast a,
        body.high-contrast label,
        body.high-contrast span {
            color: #ffff00 !important;
        }

        body.high-contrast button[type="submit"],
        body.high-contrast .bg-brand-600 {
            background-color: #ffff00 !important;
            color: #000000 !important;
            font-weight: 800 !important;
        }

        body.high-contrast button[type="submit"] *,
        body.high-contrast .bg-brand-600 * {
            color: #000000 !important;
        }

        /* Contraste Invertido */
        body.inverted-contrast #app-wrapper {
            filter: invert(1) hue-rotate(180deg);
        }

        /* Espaçamento de Texto (Dislexia / Baixa Visão) */
        body.text-spacing-wide * {
            letter-spacing: 0.08em !important;
            word-spacing: 0.16em !important;
            line-height: 1.85 !important;
        }

        /* Fonte Legível (Lexend) */
        body.readable-font,
        body.readable-font * {
            font-family: 'Lexend', sans-serif !important;
        }

        /* Cursor Ampliado */
        body.large-cursor,
        body.large-cursor * {
            cursor: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='40' height='40' viewBox='0 0 32 32'><path d='M4 2 L26 16 L16 19 L21 29 L17 31 L12 21 L4 27 Z' fill='%23ffff00' stroke='%23000000' stroke-width='2.5'/></svg>") 4 2, auto !important;
        }

        /* Pausar Animações (Sensibilidade Vestibular) */
        body.reduce-motion *,
        body.reduce-motion *::before,
        body.reduce-motion *::after {
            animation: none !important;
            transition: none !important;
            scroll-behavior: auto !important;
        }

        /* Animação das Patinhas Flutuantes */
        @keyframes floatPaw {
            0% {
                transform: translateY(0px) rotate(0deg);
                opacity: 0.2;
            }

            50% {
                transform: translateY(-15px) rotate(10deg);
                opacity: 0.45;
            }

            100% {
                transform: translateY(0px) rotate(0deg);
                opacity: 0.2;
            }
        }

        .floating-paw {
            animation: floatPaw 6s ease-in-out infinite;
            pointer-events: none;
        }

        /* Glassmorphism */
        .glass-card {
            background: rgba(255, 255, 255, 0.88);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.6);
        }

        /* =========================================================
           4. COMPONENTES DO MENU DE ACESSIBILIDADE
           ========================================================= */
        /* Destacar Links */
        body.highlight-links a,
        body.highlight-links button:not(#accessibilityMainBtn):not(.a11y-btn) {
            outline: 3px solid #facc15 !important;
            outline-offset: 2px !important;
            text-decoration: underline !important;
            text-decoration-thickness: 3px !important;
            text-decoration-color: #ef4444 !important;
        }

        /* Botões em Grid do Painel (Estilo Profissional) */
        .a11y-btn {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 0.35rem;
            padding: 0.75rem 0.25rem;
            border-radius: 0.75rem;
            border: 1px solid #e5e7eb;
            background-color: #ffffff;
            color: #4b5563;
            font-size: 0.7rem;
            font-weight: 600;
            text-align: center;
            transition: all 0.2s ease-in-out;
            line-height: 1.1;
        }

        .a11y-btn:hover {
            border-color: #cbd5e1;
            background-color: #f8fafc;
        }

        .a11y-btn.active {
            background-color: #5e8940 !important;
            border-color: #4c6c32 !important;
            color: #ffffff !important;
        }

        .a11y-btn i {
            font-size: 1.25rem;
            margin-bottom: 0.15rem;
        }
    </style>
</head>

<body
    class="bg-earth-100 text-gray-800 font-sans antialiased relative min-h-screen flex flex-col transition-colors duration-300">

    <!-- =========================================================
         DEFINIÇÕES SVG OCULTAS PARA SIMULAÇÃO / CORREÇÃO DE DALTONISMO
         Matrizes científicas calibradas (Machado et al.)
         ========================================================= -->
    <svg aria-hidden="true" class="hidden w-0 h-0 overflow-hidden" xmlns="http://www.w3.org/2000/svg">
        <defs>
            <!-- Protanopia (Deficiência de Vermelho - Daltonismo Tipo 1) -->
            <filter id="protanopia-filter">
                <feColorMatrix type="matrix" values="
                    0.567, 0.433, 0.000, 0, 0
                    0.558, 0.442, 0.000, 0, 0
                    0.000, 0.242, 0.758, 0, 0
                    0.000, 0.000, 0.000, 1, 0" />
            </filter>
            <!-- Deuteranopia (Deficiência de Verde - Daltonismo Tipo 2) -->
            <filter id="deuteranopia-filter">
                <feColorMatrix type="matrix" values="
                    0.625, 0.375, 0.000, 0, 0
                    0.700, 0.300, 0.000, 0, 0
                    0.000, 0.300, 0.700, 0, 0
                    0.000, 0.000, 0.000, 1, 0" />
            </filter>
            <!-- Tritanopia (Deficiência de Azul/Amarelo - Daltonismo Tipo 3) -->
            <filter id="tritanopia-filter">
                <feColorMatrix type="matrix" values="
                    0.950, 0.050, 0.000, 0, 0
                    0.000, 0.433, 0.567, 0, 0
                    0.000, 0.475, 0.525, 0, 0
                    0.000, 0.000, 0.000, 1, 0" />
            </filter>
            <!-- Acromatopsia (Visão Monocromática / Escala de Cinza de Alto Contraste) -->
            <filter id="achromatopsia-filter">
                <!-- WIDGET FLUTUANTE DE ACESSIBILIDADE AVANÇADA & DALTONISMO
         ========================================================= -->
                <div class="fixed bottom-5 left-5 z-50 flex flex-col items-start gap-2" role="region"
                    aria-label="Ferramentas de Acessibilidade">
                    <!-- Painel Expansível (Layout Profissional Grid) -->
                    <div id="accessibilityPanel"
                        class="hidden glass-card p-0 rounded-3xl shadow-2xl border-2 border-brand-200 w-80 sm:w-[400px] mb-2 text-sm flex flex-col max-h-[85vh] overflow-hidden">

                        <!-- Cabeçalho -->
                        <div
                            class="bg-white/90 p-4 border-b border-brand-100 flex justify-between items-center shrink-0">
                            <div>
                                <span class="font-extrabold text-brand-700 flex items-center gap-2 text-base">
                                    <i class="fa-solid fa-universal-access"></i> Menu de Acessibilidade
                                </span>
                                <span class="text-[11px] text-gray-500 block mt-0.5">Atalho: Alt + A | Ler página: Alt +
                                    L</span>
                            </div>
                            <button onclick="toggleAccessibilityPanel()" aria-label="Fechar painel de acessibilidade"
                                class="w-8 h-8 rounded-full bg-gray-100 hover:bg-gray-200 flex items-center justify-center text-gray-600 transition">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        </div>

                        <!-- Conteúdo Rolável -->
                        <div class="p-4 overflow-y-auto space-y-6 bg-gray-50/50 flex-1">

                            <!-- 1. LEITOR DE VOZ INTELIGENTE -->
                            <div>
                                <h4
                                    class="text-[11px] font-extrabold text-gray-400 uppercase tracking-widest mb-3 px-1">
                                    Leitura e Voz</h4>
                                <div class="grid grid-cols-3 gap-2">
                                    <button onclick="speakCurrentPage()" class="a11y-btn" title="Ler página atual">
                                        <i class="fa-solid fa-volume-high"></i>
                                        <span>Ler Página</span>
                                    </button>
                                    <button id="pauseResumeBtn" onclick="togglePauseSpeech()" class="a11y-btn"
                                        title="Pausar leitura">
                                        <i class="fa-solid fa-pause"></i>
                                        <span>Pausar</span>
                                    </button>
                                    <button onclick="stopSpeech()" class="a11y-btn" title="Parar leitura">
                                        <i class="fa-solid fa-stop"></i>
                                        <span>Parar Voz</span>
                                    </button>
                                </div>
                                <div class="grid grid-cols-2 gap-2 mt-2">
                                    <button onclick="toggleHoverSpeech(this)" id="btn-hover-speech" class="a11y-btn">
                                        <i class="fa-solid fa-comment-dots"></i>
                                        <span>Ler ao Apontar</span>
                                    </button>
                                    <div
                                        class="border border-gray-200 rounded-xl bg-white p-2 flex flex-col justify-center items-center gap-1">
                                        <span class="text-[10px] font-bold text-gray-500 uppercase">Velocidade</span>
                                        <div class="flex gap-1">
                                            <button onclick="setSpeechRate(0.8)" id="rate-0.8"
                                                class="rate-btn px-2 py-1 rounded text-xs bg-gray-100 text-gray-700 font-medium">Lento</button>
                                            <button onclick="setSpeechRate(1.0)" id="rate-1.0"
                                                class="rate-btn px-2 py-1 rounded text-xs bg-brand-600 text-white font-bold">1x</button>
                                            <button onclick="setSpeechRate(1.3)" id="rate-1.3"
                                                class="rate-btn px-2 py-1 rounded text-xs bg-gray-100 text-gray-700 font-medium">Rápido</button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- 2. TAMANHO E LEGIBILIDADE DO TEXTO -->
                            <div>
                                <h4
                                    class="text-[11px] font-extrabold text-gray-400 uppercase tracking-widest mb-3 px-1">
                                    Ajustes de Texto</h4>
                                <div class="grid grid-cols-3 gap-2 mb-2">
                                    <button onclick="changeFontSize(-1)" class="a11y-btn">
                                        <i class="fa-solid fa-minus"></i>
                                        <span>Diminuir</span>
                                    </button>
                                    <button onclick="resetFontSize()" class="a11y-btn text-lg font-mono">
                                        100%
                                    </button>
                                    <button onclick="changeFontSize(1)" class="a11y-btn">
                                        <i class="fa-solid fa-plus"></i>
                                        <span>Aumentar</span>
                                    </button>
                                </div>
                                <div class="grid grid-cols-2 gap-2">
                                    <button
                                        onclick="toggleFeature('readable-font', this, 'Fonte legível para dislexia')"
                                        id="btn-readable-font" class="a11y-btn">
                                        <i class="fa-solid fa-font"></i>
                                        <span>Fonte Dislexia</span>
                                    </button>
                                    <button
                                        onclick="toggleFeature('text-spacing-wide', this, 'Espaçamento de texto aumentado')"
                                        id="btn-text-spacing-wide" class="a11y-btn">
                                        <i class="fa-solid fa-text-width"></i>
                                        <span>Espaçamento</span>
                                    </button>
                                </div>
                            </div>

                            <!-- 3. CONTRASTE VISUAL & DALTONISMO -->
                            <div>
                                <h4
                                    class="text-[11px] font-extrabold text-gray-400 uppercase tracking-widest mb-3 px-1">
                                    Cores e Contraste</h4>
                                <div class="grid grid-cols-2 gap-2 mb-2">
                                    <button onclick="setContrastMode('high')" id="contrast-high" class="a11y-btn">
                                        <i class="fa-solid fa-circle-half-stroke"></i>
                                        <span>Alto Contraste</span>
                                    </button>
                                    <button onclick="setContrastMode('inverted')" id="contrast-inverted"
                                        class="a11y-btn">
                                        <i class="fa-solid fa-droplet"></i>
                                        <span>Cores Invertidas</span>
                                    </button>
                                </div>
                                <div class="border border-gray-200 rounded-xl bg-white p-3 space-y-2 shadow-sm">
                                    <label for="colorBlindSelect"
                                        class="block text-[11px] font-bold text-gray-500 uppercase text-center flex items-center justify-center gap-1">
                                        <i class="fa-solid fa-eye"></i> Filtros de Daltonismo
                                    </label>
                                    <select id="colorBlindSelect" onchange="setColorBlindMode(this.value)"
                                        class="w-full p-2.5 rounded-lg border border-gray-200 bg-gray-50 text-xs font-semibold focus:ring-2 focus:ring-brand-500 text-center text-gray-700 outline-none">
                                        <option value="none">Padrão (Sem filtro)</option>
                                        <option value="protanopia">Protanopia (Sem Vermelho)</option>
                                        <option value="deuteranopia">Deuteranopia (Sem Verde)</option>
                                        <option value="tritanopia">Tritanopia (Sem Azul)</option>
                                        <option value="achromatopsia">Acromatopsia (Escala de cinza)</option>
                                    </select>
                                </div>
                            </div>

                            <!-- 4. NAVEGAÇÃO E FOCO -->
                            <div>
                                <h4
                                    class="text-[11px] font-extrabold text-gray-400 uppercase tracking-widest mb-3 px-1">
                                    Navegação e Foco</h4>
                                <div class="grid grid-cols-2 gap-2">
                                    <button onclick="toggleReadingGuide(this)" id="btn-reading-guide" class="a11y-btn">
                                        <i class="fa-solid fa-ruler-horizontal"></i>
                                        <span>Guia de Leitura</span>
                                    </button>
                                    <button onclick="toggleFeature('large-cursor', this, 'Cursor ampliado')"
                                        id="btn-large-cursor" class="a11y-btn">
                                        <i class="fa-solid fa-arrow-pointer"></i>
                                        <span>Cursor Maior</span>
                                    </button>
                                    <button onclick="toggleFeature('highlight-links', this, 'Destaque de links')"
                                        id="btn-highlight-links" class="a11y-btn">
                                        <i class="fa-solid fa-link"></i>
                                        <span>Destacar Links</span>
                                    </button>
                                    <button onclick="toggleFeature('reduce-motion', this, 'Pausa de animações')"
                                        id="btn-reduce-motion" class="a11y-btn">
                                        <i class="fa-solid fa-ban"></i>
                                        <span>Parar Animações</span>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Rodapé: Reset -->
                        <div class="p-4 border-t border-gray-200 bg-white shrink-0">
                            <button onclick="resetAllAccessibility()"
                                class="w-full bg-red-50 hover:bg-red-100 text-red-700 py-3 rounded-xl text-xs font-bold transition flex items-center justify-center gap-2 border border-red-200">
                                <i class="fa-solid fa-rotate-left"></i>
                                <span>Restaurar Padrões Originais</span>
                            </button>
                        </div>
                    </div>

                    <!-- Botão Flutuante Principal -->
                    <button onclick="toggleAccessibilityPanel()" aria-expanded="false" id="accessibilityMainBtn"
                        class="bg-brand-600 hover:bg-brand-700 text-white px-4 py-3.5 rounded-full shadow-2xl flex items-center justify-center gap-2.5 transition hover:scale-105 border-2 border-white">
                        <i class="fa-solid fa-universal-access text-xl"></i>
                        <span class="text-xs font-bold tracking-wide">Acessibilidade & Daltonismo</span>
                    </button>
                </div>

                <!-- =========================================================
         WRAPPER PRINCIPAL (Recebe filtros SVG de Daltonismo)
         ========================================================= -->
                <div id="app-wrapper" class="flex flex-col min-h-screen relative">

                    <!-- Patinhas Decorativas Flutuantes de Fundo -->
                    <div class="fixed inset-0 overflow-hidden pointer-events-none z-0" aria-hidden="true">
                        <i class="fa-solid fa-paw text-brand-500/10 text-6xl absolute top-20 left-10 floating-paw"
                            style="animation-delay: 0s;"></i>
                        <i class="fa-solid fa-paw text-earth-500/15 text-8xl absolute top-1/3 right-12 floating-paw"
                            style="animation-delay: 2s;"></i>
                        <i class="fa-solid fa-paw text-brand-500/10 text-5xl absolute bottom-1/4 left-1/4 floating-paw"
                            style="animation-delay: 4s;"></i>
                        <i class="fa-solid fa-paw text-earth-500/20 text-7xl absolute bottom-10 right-1/3 floating-paw"
                            style="animation-delay: 1s;"></i>
                    </div>

                    <!-- CABEÇALHO / NAVBAR -->
                    <header class="sticky top-0 z-40 glass-card border-b border-brand-100">
                        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
                            <a href="#" onclick="navigateTo('home'); return false;"
                                class="flex items-center gap-3 group no-underline-cb"
                                aria-label="Cão Guia Digital - IF Goiano - Ir para o início">
                                <div
                                    class="w-12 h-12 bg-brand-600 rounded-2xl flex items-center justify-center text-white text-2xl shadow-lg shadow-brand-600/30 group-hover:scale-105 transition">
                                    <i class="fa-solid fa-paw" aria-hidden="true"></i>
                                </div>
                                <div>
                                    <span
                                        class="text-xl font-extrabold text-gray-900 tracking-tight leading-none group-hover:text-brand-600 transition block">
                                        Cão Guia Digital
                                    </span>
                                    <span
                                        class="text-xs font-semibold text-brand-600 tracking-wider uppercase block mt-0.5">
                                        IF Goiano
                                    </span>
                                </div>
                            </a>

                            <div class="flex items-center gap-3">
                                <!-- Indicador Ativo de Modo Daltonismo (quando ativado) -->
                                <span id="activeCbBadge"
                                    class="hidden status-badge bg-blue-100 text-blue-900 px-3 py-1.5 rounded-xl text-xs font-bold items-center gap-1.5">
                                    <i class="fa-solid fa-eye"></i>
                                    <span id="activeCbLabel">Modo Daltônico</span>
                                </span>

                                <button onclick="navigateTo('solicitar-cao')"
                                    class="hidden sm:flex items-center gap-2 bg-brand-600 hover:bg-brand-700 text-white px-5 py-2.5 rounded-xl font-medium text-sm transition shadow-md shadow-brand-600/20">
                                    <i class="fa-solid fa-shield-dog" aria-hidden="true"></i>
                                    <span>Solicitar Cão Guia</span>
                                </button>

                                <button id="hamburgerBtn" onclick="toggleSidebarMenu()" aria-expanded="false"
                                    aria-controls="sidebarMenu"
                                    class="w-12 h-12 bg-brand-50 hover:bg-brand-100 text-brand-700 rounded-xl flex items-center justify-center text-xl transition border border-brand-200"
                                    aria-label="Abrir menu de navegação">
                                    <i id="hamburgerIcon" class="fa-solid fa-bars" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>
                    </header>

                    <!-- MENU LATERAL (SIDEBAR DRAWER) -->
                    <div id="sidebarOverlay" onclick="toggleSidebarMenu()"
                        class="fixed inset-0 bg-black/40 backdrop-blur-sm z-50 opacity-0 pointer-events-none transition-opacity duration-300">
                    </div>

                    <aside id="sidebarMenu" role="dialog" aria-label="Menu de Navegação Principal"
                        class="fixed top-0 right-0 h-full w-80 max-w-[85vw] glass-card z-50 shadow-2xl translate-x-full transition-transform duration-300 flex flex-col justify-between overflow-y-auto">
                        <div class="p-6">
                            <div class="flex items-center justify-between pb-6 border-b border-gray-200">
                                <div class="flex items-center gap-2">
                                    <i class="fa-solid fa-paw text-brand-600 text-xl" aria-hidden="true"></i>
                                    <span class="font-bold text-gray-900">Navegação</span>
                                </div>
                                <button onclick="toggleSidebarMenu()" aria-label="Fechar menu de navegação"
                                    class="w-9 h-9 rounded-full bg-gray-100 hover:bg-gray-200 flex items-center justify-center text-gray-600 transition">
                                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                                </button>
                            </div>

                            <nav class="mt-6 flex flex-col gap-2" aria-label="Seções do portal">
                                <button onclick="navigateTo('home')"
                                    class="nav-btn flex items-center gap-3 px-4 py-3 rounded-xl text-left text-gray-700 hover:bg-brand-50 hover:text-brand-600 font-medium transition">
                                    <i class="fa-solid fa-house text-lg w-6" aria-hidden="true"></i>
                                    <span>Início (Home)</span>
                                </button>
                                <button onclick="navigateTo('solicitar-cao')"
                                    class="nav-btn flex items-center gap-3 px-4 py-3 rounded-xl text-left font-semibold text-brand-700 bg-brand-50 hover:bg-brand-100 transition border border-brand-200">
                                    <i class="fa-solid fa-shield-dog text-lg w-6" aria-hidden="true"></i>
                                    <span>Solicitar Cão Guia</span>
