                <!-- =========================================================
         JAVASCRIPT: SPA, LEITOR DE VOZ, DALTONISMO & PERSISTÊNCIA
         ========================================================= -->
                <script>
                    // --- 1. NAVEGAÇÃO SPA ACESSÍVEL ---
                    function navigateTo(sectionId) {
                        document.querySelectorAll('.spa-section').forEach(sec => sec.classList.add('hidden'));
                        const target = document.getElementById(`sec-${sectionId}`);
                        if (target) {
                            target.classList.remove('hidden');
                            window.scrollTo({ top: 0, behavior: document.body.classList.contains('reduce-motion') ? 'auto' : 'smooth' });
                            const heading = target.querySelector('h1, h2');
                            if (heading) {
                                announceScreenReader(`Navegou para: ${heading.innerText}`);
                            }
                        }
                        closeSidebarMenu();
                    }

                    function announceScreenReader(msg) {
                        const announcer = document.getElementById('ariaLiveAnnouncer');
                        if (announcer) {
                            announcer.textContent = '';
                            setTimeout(() => { announcer.textContent = msg; }, 50);
                        }
                    }

                    function showToast(message) {
                        const toast = document.getElementById('toastNotification');
                        const toastMsg = document.getElementById('toastMessage');
                        toastMsg.innerText = message;
                        toast.classList.remove('translate-x-[130%]');
                        announceScreenReader(message);
                        setTimeout(() => {
                            toast.classList.add('translate-x-[130%]');
                        }, 4500);
                    }

                    // --- 2. CONTROLE DO MENU HAMBÚRGUER LATERAL ---
                    function toggleSidebarMenu() {
                        const sidebar = document.getElementById('sidebarMenu');
                        const overlay = document.getElementById('sidebarOverlay');
                        const btn = document.getElementById('hamburgerBtn');
                        const isOpened = !sidebar.classList.contains('translate-x-full');

                        if (isOpened) {
                            closeSidebarMenu();
                        } else {
                            sidebar.classList.remove('translate-x-full');
                            overlay.classList.remove('opacity-0', 'pointer-events-none');
                            btn.setAttribute('aria-expanded', 'true');
                        }
                    }

                    function closeSidebarMenu() {
                        const sidebar = document.getElementById('sidebarMenu');
                        const overlay = document.getElementById('sidebarOverlay');
                        const btn = document.getElementById('hamburgerBtn');
                        sidebar.classList.add('translate-x-full');
                        overlay.classList.add('opacity-0', 'pointer-events-none');
                        if (btn) btn.setAttribute('aria-expanded', 'false');
                    }

                    // --- 3. FILTRO E MODAL DE NOTÍCIAS ---
                    function filterNews() {
                        const query = document.getElementById('newsSearch').value.toLowerCase();
                        const cards = document.querySelectorAll('.news-card');
                        cards.forEach(card => {
                            const title = card.querySelector('.news-title').innerText.toLowerCase();
                            card.classList.toggle('hidden', !title.includes(query));
                        });
                    }

                    function openNewsModal(title, body, date) {
                        document.getElementById('modalTitle').innerText = title;
                        document.getElementById('modalBody').innerText = body;
                        document.getElementById('modalDate').innerText = date;
                        const modal = document.getElementById('newsModal');
                        modal.classList.remove('opacity-0', 'pointer-events-none');
                    }

                    function closeNewsModal() {
                        const modal = document.getElementById('newsModal');
                        modal.classList.add('opacity-0', 'pointer-events-none');
                    }

                    // --- 4. LEITOR DE VOZ AVANÇADO (WEB SPEECH API) ---
                    const synth = window.speechSynthesis;
                    let speechRate = 1.0;
                    let highlightedElement = null;
                    let hoverSpeechEnabled = false;

                    function clearHighlight() {
                        if (highlightedElement) {
                            highlightedElement.classList.remove('reader-highlight');
                            highlightedElement = null;
                        }
                    }

                    function speakText(text, targetEl = null) {
                        if (!synth) return;
                        synth.cancel();
                        clearHighlight();
                        if (!text || !text.trim()) return;

                        if (targetEl) {
                            highlightedElement = targetEl;
                            highlightedElement.classList.add('reader-highlight');
                        }

                        const utterance = new SpeechSynthesisUtterance(text);
                        utterance.lang = 'pt-BR';
                        utterance.rate = speechRate;
                        utterance.onend = () => clearHighlight();
                        utterance.onerror = () => clearHighlight();
                        synth.speak(utterance);
                    }

                    function togglePauseSpeech() {
                        if (!synth) return;
                        const btn = document.getElementById('pauseResumeBtn');
                        if (synth.speaking && !synth.paused) {
                            synth.pause();
                            btn.innerHTML = '<i class="fa-solid fa-play"></i> Retomar';
                        } else if (synth.paused) {
                            synth.resume();
                            btn.innerHTML = '<i class="fa-solid fa-pause"></i> Pausar';
                        }
                    }

                    function stopSpeech() {
                        if (synth) synth.cancel();
                        clearHighlight();
                        const btn = document.getElementById('pauseResumeBtn');
                        if (btn) btn.innerHTML = '<i class="fa-solid fa-pause"></i><br><span>Pausar</span>';
                    }

                    function speakCurrentPage() {
                        const activeSection = document.querySelector('.spa-section:not(.hidden)');
                        if (activeSection) {
                            speakText(activeSection.innerText, activeSection);
                        }
                    }

                    function setSpeechRate(rate) {
                        speechRate = rate;
                        ['0.8', '1.0', '1.3'].forEach(r => {
                            const btn = document.getElementById(`rate-${r}`);
                            if (btn) {
                                btn.classList.remove('bg-brand-600', 'text-white', 'font-bold');
                                btn.classList.add('bg-gray-100', 'text-gray-700', 'font-medium');
                            }
                        });
                        const activeBtn = document.getElementById(`rate-${rate.toFixed(1)}`);
                        if (activeBtn) {
                            activeBtn.classList.remove('bg-gray-100', 'text-gray-700', 'font-medium');
                            activeBtn.classList.add('bg-brand-600', 'text-white', 'font-bold');
                        }
                        saveAccessibilityPrefs();
                        showToast(`Velocidade da voz alterada para ${rate}x`);
                    }

                    function toggleHoverSpeech(btnEl) {
                        hoverSpeechEnabled = !hoverSpeechEnabled;
                        if (btnEl) btnEl.classList.toggle('active', hoverSpeechEnabled);
                        showToast(hoverSpeechEnabled ? 'Leitura ao apontar ativada.' : 'Leitura ao apontar desativada.');
                        saveAccessibilityPrefs();
                    }

                    // Leitura ao passar o mouse ou focar com Tab
                    function handleAutoReadEvent(e) {
                        if (hoverSpeechEnabled) {
                            const target = e.target.closest('p, h1, h2, h3, button, a, summary, label, li');
                            if (target && target.innerText && !target.closest('#accessibilityPanel')) {
                                speakText(target.innerText, target);
                            }
                        }
                    }
                    document.addEventListener('mouseover', handleAutoReadEvent);
                    document.addEventListener('focusin', handleAutoReadEvent);

                    // --- 5. DALTONISMO, CONTRASTE E TIPOGRAFIA ---
                    function toggleAccessibilityPanel() {
                        const panel = document.getElementById('accessibilityPanel');
                        const btn = document.getElementById('accessibilityMainBtn');
                        panel.classList.toggle('hidden');
                        btn.setAttribute('aria-expanded', String(!panel.classList.contains('hidden')));
                    }

                    const cbLabels = {
                        none: '',
                        protanopia: 'Daltonismo: Protanopia',
                        deuteranopia: 'Daltonismo: Deuteranopia',
                        tritanopia: 'Daltonismo: Tritanopia',
                        achromatopsia: 'Daltonismo: Acromatopsia'
                    };

                    function setColorBlindMode(mode) {
                        document.body.classList.remove('cb-protanopia', 'cb-deuteranopia', 'cb-tritanopia', 'cb-achromatopsia');
                        const badge = document.getElementById('activeCbBadge');
                        const badgeLabel = document.getElementById('activeCbLabel');

                        if (mode && mode !== 'none') {
                            document.body.classList.add(`cb-${mode}`);
                            badge.classList.remove('hidden');
                            badge.classList.add('flex');
                            badgeLabel.innerText = cbLabels[mode];
                            showToast(`Modo ${cbLabels[mode]} ativado com indicadores visuais reforçados.`);
                        } else {
                            badge.classList.add('hidden');
                            badge.classList.remove('flex');
                        }
                        document.getElementById('colorBlindSelect').value = mode || 'none';
                        saveAccessibilityPrefs();
                    }

                    function setContrastMode(mode) {
                        const isCurrentlyActive = document.body.classList.contains(mode === 'high' ? 'high-contrast' : 'inverted-contrast');

                        document.body.classList.remove('high-contrast', 'inverted-contrast');
                        document.querySelectorAll('.contrast-btn').forEach(btn => {
                            btn.classList.remove('active');
                        });

                        if (!isCurrentlyActive && mode !== 'normal') {
                            if (mode === 'high') {
                                document.body.classList.add('high-contrast');
                                const btn = document.getElementById('contrast-high');
                                if (btn) btn.classList.add('active');
                                showToast('Modo de Alto Contraste ativado.');
                            } else if (mode === 'inverted') {
                                document.body.classList.add('inverted-contrast');
                                const btn = document.getElementById('contrast-inverted');
                                if (btn) btn.classList.add('active');
                                showToast('Modo de Cores Invertidas ativado.');
                            }
                        } else {
                            showToast('Contraste padrão restaurado.');
                        }

                        saveAccessibilityPrefs();
                    }

                    let currentFontSize = 100;
                    function changeFontSize(delta) {
                        currentFontSize = Math.min(150, Math.max(80, currentFontSize + delta * 10));
                        document.documentElement.style.fontSize = `${currentFontSize}%`;
                        showToast(`Tamanho da fonte: ${currentFontSize}%`);
                        saveAccessibilityPrefs();
                    }

                    function resetFontSize() {
                        currentFontSize = 100;
                        document.documentElement.style.fontSize = '100%';
                        showToast('Tamanho da fonte restaurado (100%).');
                        saveAccessibilityPrefs();
                    }

                    function toggleFeature(className, btnEl, featureName) {
                        document.body.classList.toggle(className);
                        const active = document.body.classList.contains(className);
                        if (btnEl) {
                            btnEl.classList.toggle('active', active);
                        }
                        if (featureName) {
                            showToast(`${featureName} ${active ? 'ativado(a)' : 'desativado(a)'}.`);
                        }
                        saveAccessibilityPrefs();
                    }

                    // Régua Guia de Leitura Horizontal
                    let readingGuideActive = false;
                    function toggleReadingGuide(btnEl) {
                        readingGuideActive = !readingGuideActive;
                        const guide = document.getElementById('readingGuide');
                        guide.classList.toggle('hidden', !readingGuideActive);
                        if (btnEl) {
                            btnEl.classList.toggle('active', readingGuideActive);
                        }
                        showToast(`Guia de leitura ${readingGuideActive ? 'ativada' : 'desativada'}.`);
                        saveAccessibilityPrefs();
                    }

                    document.addEventListener('mousemove', (e) => {
                        if (readingGuideActive) {
                            const guide = document.getElementById('readingGuide');
                            guide.style.top = `${e.clientY - 24}px`;
                        }
                    });

                    // Atalhos de Teclado Globais (Alt + A, Alt + L, Esc)
                    document.addEventListener('keydown', (e) => {
                        if (e.altKey && e.key.toLowerCase() === 'a') {
                            e.preventDefault();
                            toggleAccessibilityPanel();
                        } else if (e.altKey && e.key.toLowerCase() === 'l') {
                            e.preventDefault();
                            speakCurrentPage();
                        } else if (e.key === 'Escape') {
                            closeSidebarMenu();
                            closeNewsModal();
                            const panel = document.getElementById('accessibilityPanel');
                            if (!panel.classList.contains('hidden')) toggleAccessibilityPanel();
                        }
                    });

                    // --- 6. PERSISTÊNCIA EM LOCALSTORAGE ---
                    function saveAccessibilityPrefs() {
                        try {
                            const prefs = {
                                colorBlind: document.getElementById('colorBlindSelect').value,
                                contrast: document.body.classList.contains('high-contrast') ? 'high' : (document.body.classList.contains('inverted-contrast') ? 'inverted' : 'normal'),
                                fontSize: currentFontSize,
                                speechRate: speechRate,
                                hoverSpeech: hoverSpeechEnabled,
                                readableFont: document.body.classList.contains('readable-font'),
                                textSpacing: document.body.classList.contains('text-spacing-wide'),
                                largeCursor: document.body.classList.contains('large-cursor'),
                                reduceMotion: document.body.classList.contains('reduce-motion'),
                                highlightLinks: document.body.classList.contains('highlight-links'),
                                readingGuide: readingGuideActive
                            };
                            localStorage.setItem('cgd_a11y_prefs', JSON.stringify(prefs));
                        } catch (err) { }
                    }

                    function loadAccessibilityPrefs() {
                        try {
                            const raw = localStorage.getItem('cgd_a11y_prefs');
                            if (!raw) return;
                            const prefs = JSON.parse(raw);

                            if (prefs.colorBlind) setColorBlindMode(prefs.colorBlind);
                            if (prefs.contrast) setContrastMode(prefs.contrast);
                            if (prefs.fontSize) {
                                currentFontSize = prefs.fontSize;
                                document.documentElement.style.fontSize = `${currentFontSize}%`;
                            }
                            if (prefs.speechRate) setSpeechRate(prefs.speechRate);
                            if (prefs.hoverSpeech) toggleHoverSpeech(document.getElementById('btn-hover-speech'));
                            if (prefs.readableFont) toggleFeature('readable-font', document.getElementById('btn-readable-font'));
                            if (prefs.textSpacing) toggleFeature('text-spacing-wide', document.getElementById('btn-text-spacing-wide'));
                            if (prefs.largeCursor) toggleFeature('large-cursor', document.getElementById('btn-large-cursor'));
                            if (prefs.reduceMotion) toggleFeature('reduce-motion', document.getElementById('btn-reduce-motion'));
                            if (prefs.highlightLinks) toggleFeature('highlight-links', document.getElementById('btn-highlight-links'));
                            if (prefs.readingGuide) toggleReadingGuide(document.getElementById('btn-reading-guide'));
                        } catch (err) { }
                    }

                    function resetAllAccessibility() {
                        localStorage.removeItem('cgd_a11y_prefs');
                        setColorBlindMode('none');
                        document.body.classList.remove('high-contrast', 'inverted-contrast');
                        document.querySelectorAll('.contrast-btn').forEach(btn => btn.classList.remove('active'));

                        resetFontSize();
                        setSpeechRate(1.0);
                        stopSpeech();
                        hoverSpeechEnabled = false;

                        document.body.classList.remove('readable-font', 'text-spacing-wide', 'large-cursor', 'reduce-motion', 'highlight-links');
                        document.querySelectorAll('.a11y-btn').forEach(btn => {
                            btn.classList.remove('active');
                        });

                        readingGuideActive = false;
                        document.getElementById('readingGuide').classList.add('hidden');
                        showToast('Todas as configurações de acessibilidade foram restauradas ao padrão.');
                    }

                    // --- 7. AUXILIARES (PIX E FORMULÁRIOS SEM ALERT BLOQUEADO) ---
                    function copyPix() {
                        const pix = document.getElementById('pixKey').innerText;
                        const tempInput = document.createElement('input');
                        tempInput.value = pix;
                        document.body.appendChild(tempInput);
                        tempInput.select();
                        document.execCommand('copy');
                        document.body.removeChild(tempInput);
                        showToast('Chave Pix copiada para a área de transferência!');
                    }

                    function handleFormSubmit(e, message) {
                        e.preventDefault();
                        showToast(message);
                        e.target.reset();
                    }

                    window.addEventListener('DOMContentLoaded', loadAccessibilityPrefs);
                </script>
</body>

